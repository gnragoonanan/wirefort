# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Site-specific value overrides must never be packaged into the chart archive
values.yaml.working
values.yaml.local
*-values.yaml
values-*.yaml
secrets.yaml
# Generated WireGuard material
*.key
*.conf
init.log
